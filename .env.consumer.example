# --------- APP --------- # 
APP_PORT=8080
LOGS_PATH=./logs
ENV_PATH=./.env
LOG_LEVEL_APP=DEBUG

# --------- APP-KAFKA --------- # 
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=wb-order-created-v1
KAFKA_GROUP=order-service-created-consumer-v1
LOG_LEVEL_KAFKA=DEBUG
KAFKA_DLQ_TOPIC=wb-order-dlq-v1

# --------- APP-POSTGRES --------- # 
DB_LINK=postgres://user:pass@database:5432/level_0
LOG_LEVEL_DATABASE=DEBUG

# --------- APP-SERVER--------- # 
LOG_LEVEL_SERVER=DEBUG

# --------- APP-SERVICE--------- # 
LOG_LEVEL_SERVICE=DEBUG

# --------- APP-CACHE--------- # 
LOG_LEVEL_CACHE=DEBUG
CACHE_CAPACITY=5
TTL_ORDER=60