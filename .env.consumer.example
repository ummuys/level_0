# --------- APP --------- # 
APP_PORT=8080
LOGS_PATH=./logs
ENV_PATH=./.env
LOG_LEVEL_APP=INFO

# --------- APP-KAFKA --------- # 
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=wb-order-created-v1
KAFKA_GROUP=order-service-created-consumer-v1
LOG_LEVEL_KAFKA=INFO
KAFKA_DLQ_TOPIC=wb-order-dlq-v1

# --------- APP-POSTGRES --------- # 
DB_LINK=postgres://user:pass@database:5432/level_0
LOG_LEVEL_DATABASE=INFO

# --------- APP-SERVER--------- # 
LOG_LEVEL_SERVER=INFO

# --------- APP-SERVICE--------- # 
LOG_LEVEL_SERVICE=INFO

# --------- APP-CACHE--------- # 
LOG_LEVEL_CACHE=INFO
CACHE_CAPACITY=5
TTL_ORDER=60